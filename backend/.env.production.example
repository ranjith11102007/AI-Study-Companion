# Production / hosted configuration (the "143" plan).
#
# Copy to a secret store or the host's env-var UI — do NOT commit a real file.
#   docker run --env-file backend/.env.production ...
#
# Locally you keep using backend/.env with the Ollama defaults; this template is
# only for a host that has no local Ollama.

APP_ENV=production
DEBUG=false
# REQUIRED, >= 32 chars (startup fails otherwise). Render can generate this.
SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
# Set to your deployed origin(s); never leave "*" in a real public deployment.
CORS_ORIGINS=*

# --- Database: managed PostgreSQL + pgvector (Supabase / Neon, free tier) ---
# Example Supabase session-pooler URL:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# --- AI runtime ---
# The project's core is LOCAL: run Ollama (or another local runtime) and no AI
# data leaves your infrastructure. The OpenAI-compatible block below is an
# explicit, opt-in escape hatch for hosts that genuinely cannot run a local
# model — the app never switches to a paid/cloud provider on its own, and it is
# only used when you set CHAT_PROVIDER/EMBEDDING_PROVIDER to "openai" yourself.
# Alternatives that speak the OpenAI API: LM Studio, vLLM, Groq (chat only — no
# embeddings), OpenRouter. See docs/deployment.md.
CHAT_PROVIDER=openai
EMBEDDING_PROVIDER=openai
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_CHAT_MODEL=gemini-flash-latest
OPENAI_EMBED_MODEL=gemini-embedding-001
# gemini-embedding-001 defaults to 3072 dims; ask for 768 to match the DB.
OPENAI_EMBED_DIMENSION=768
OPENAI_API_KEY=

# Embeddings must match the database vector column (768).
EMBEDDING_DIMENSION=768

# Indexing splits a document into embedding batches and retries transient
# failures, so a 100+ chunk PDF finishes against a batching/rate-limited API.
# Gemini's free tier caps a batch at 100 passages and allows ~100 embedding
# requests per minute, so the second batch of a large PDF is retried after a
# short backoff rather than failing the upload.
EMBEDDING_BATCH_SIZE=100
EMBEDDING_MAX_ATTEMPTS=4
EMBEDDING_RETRY_BASE_SECONDS=5.0

# --- Uploads / ingestion ---
MAX_UPLOAD_SIZE_MB=15
ALLOWED_MATERIAL_EXTENSIONS=pdf,pptx,png,jpg,jpeg,webp,txt,md
OCR_ENABLED=true

# --- Rate limiting (per process) ---
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=30
LLM_RATE_LIMIT_PER_MINUTE=60

# --- Optional global web search (Mode C: /api/search/web) ---
# OFF by default. Leave SEARCH_PROVIDER empty and no request ever leaves the
# server; core tutoring, summaries and assessments never use it. To enable,
# set this to "brave" and paste a Brave Search API key (documented free tier):
# https://api-dashboard.search.brave.com
SEARCH_PROVIDER=
BRAVE_SEARCH_API_KEY=
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_SECONDS=10.0
SEARCH_MAX_CONTEXT_CHARS=4000
