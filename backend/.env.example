# ============================================================
# AI Study Companion - backend/.env.example
# Copy to backend/.env  ( cp backend/.env.example backend/.env )
# Everything has a working default; only change what you need.
# ============================================================

# --- Application ---
APP_NAME="AI Study Companion"
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Comma separated list, or * for unrestricted (frontend runs on the same PC)
CORS_ORIGINS=*

# --- PostgreSQL + pgvector ---
# Paste YOUR OWN connection string into backend/.env - never commit real secrets.
# The value below is a REDACTED example only; replace every placeholder.
#
# Supabase (recommended: copy the URI from Settings -> Database -> Connection string):
#   Direct (IPv6):   postgresql://postgres:PASSWORD@db.<project-ref>.supabase.co:5432/postgres
#   Session pooler:  postgresql://postgres.<project-ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
# The app converts postgresql:// -> postgresql+asyncpg:// and sslmode=require -> ssl=require
# automatically, and forces SSL for *.supabase.co / *.supabase.com hosts.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Local PostgreSQL alternative: postgresql+asyncpg://studymate:studymate@127.0.0.1:5432/studymate
DB_ECHO=false
DB_CONNECT_TIMEOUT_SECONDS=3

# Used by docker-compose.yml (keep in sync with DATABASE_URL above)
POSTGRES_USER=studymate
POSTGRES_PASSWORD=studymate
POSTGRES_DB=studymate
POSTGRES_PORT=5432

# --- Local AI: Ollama (no paid APIs, no cloud) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
# nomic-embed-text -> 768 | all-minilm -> 384 | mxbai-embed-large -> 1024
EMBEDDING_DIMENSION=768

# --- AI runtime: which provider serves chat + embeddings ---
# "ollama" (default, local-first) or "openai" (any OpenAI-compatible HTTP API).
# A hosted deployment has no local Ollama, so it sets both to "openai"; see
# backend/.env.production.example and docs/deployment.md. Leaving them as
# "ollama" keeps everything local with zero cloud calls.
CHAT_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# --- OpenAI-compatible API (used only when a provider above is "openai") ---
# Works with OpenAI, Groq, OpenRouter, Google Gemini's /openai endpoint,
# LM Studio, llamafile or a local vLLM. Example (free Google Gemini tier):
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OPENAI_CHAT_MODEL=gemini-flash-latest
#   OPENAI_EMBED_MODEL=gemini-embedding-001
#   OPENAI_EMBED_DIMENSION=768   # gemini-embedding-001 defaults to 3072
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
# Only for OpenAI text-embedding-3-* to force a size (0 = don't send).
OPENAI_EMBED_DIMENSION=0

# --- Auth ---
# REQUIRED outside development (startup fails if left as the default or < 32 chars).
SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Uploads / ingestion ---
UPLOAD_DIR=uploads
PROCESSED_DIR=processed
MAX_UPLOAD_SIZE_MB=25
ALLOWED_MATERIAL_EXTENSIONS=pdf,pptx,png,jpg,jpeg,webp,txt,md
CHUNK_SIZE=900
CHUNK_OVERLAP=150
# A long document can produce more chunks than one embedding request may carry,
# so indexing embeds them in batches and retries transient provider failures
# instead of failing the whole document.
#   EMBEDDING_BATCH_SIZE   max passages per request (Gemini's /openai embeddings
#                          answers HTTP 400 "at most 100 requests can be in one
#                          batch" above 100).
#   EMBEDDING_MAX_ATTEMPTS total tries per batch (free tiers are ~100
#                          requests/minute; a 100+ chunk PDF needs a second call
#                          a minute later, which answers 429 without a retry).
#   EMBEDDING_RETRY_BASE_SECONDS  backoff base; waits grow 3x per attempt,
#                          capped at 60s.
EMBEDDING_BATCH_SIZE=100
EMBEDDING_MAX_ATTEMPTS=4
EMBEDDING_RETRY_BASE_SECONDS=5.0
# Image OCR (Tesseract). Set TESSERACT_CMD if it is not on PATH.
OCR_ENABLED=true
TESSERACT_CMD=

# --- Retrieval / grounded tutoring ---
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.15
RETRIEVAL_CANDIDATE_K=20
TUTOR_MAX_CONTEXT_CHARS=6000
TUTOR_MAX_TOKENS=700
TUTOR_TEMPERATURE=0.1
TUTOR_EXCERPT_CHARS=320

# --- Assessment engine ---
ASSESSMENT_MAX_QUESTIONS=20
ASSESSMENT_NUMERIC_TOLERANCE=0.01

# --- Optional global web search (Mode C: /api/search/web) ---
# DISABLED by default: leave SEARCH_PROVIDER empty and no request ever leaves
# the machine. Core tutoring, summaries and assessments never use this.
# "brave" = Brave Search API (documented free tier, one key; ~1 req/s and a
# monthly query allowance). Create a key at https://api-dashboard.search.brave.com
# and paste it into backend/.env only — never commit it.
SEARCH_PROVIDER=
BRAVE_SEARCH_API_KEY=
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_SECONDS=10.0
SEARCH_MAX_CONTEXT_CHARS=4000

# --- Learner model (BKT) ---
BKT_PRIOR_LEARNED=0.3
BKT_LEARN_RATE=0.2
BKT_GUESS=0.2
BKT_SLIP=0.1
BKT_MASTERY_THRESHOLD=0.7

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=30
LLM_RATE_LIMIT_PER_MINUTE=60

# --- CORS (set an explicit origin list in production) ---
CORS_ORIGINS=*
